<!--
    NorthCommander "Norton Commander" theme: all colours and the colour-related styles live here.
    Palette uses the classic CGA/EGA values (blue #0000A8, bright cyan #55FFFF, yellow #FFFF55, grey #AAAAAA).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0000A8" />
            <SolidColorBrush x:Key="PanelForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MarkedItemBrush" Color="#FFFF55" />
            <SolidColorBrush x:Key="ActivePanelBrush" Color="#55FFFF" />
            <SolidColorBrush x:Key="ActivePanelForegroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="InactivePanelBrush" Color="#AAAAAA" />
            <SolidColorBrush x:Key="InactivePanelForegroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="CursorBrush" Color="#00A8A8" />
            <SolidColorBrush x:Key="CursorForegroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="InactiveCursorBrush" Color="#3355FFFF" />
            <SolidColorBrush x:Key="HoverBrush" Color="#225555FF" />
            <SolidColorBrush x:Key="ColumnHeaderBrush" Color="#55FFFF" />
            <SolidColorBrush x:Key="DropTargetBrush" Color="#FFFF55" />
            <SolidColorBrush x:Key="KeyBarForegroundBrush" Color="#55FFFF" />
            <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#000080" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF5555" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#55FF55" />
            <SolidColorBrush x:Key="ArchiveBrush" Color="#FF55FF" />
            <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#88000000" />
            <FontFamily x:Key="RetroFontFamily">Cascadia Mono, Consolas, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
    </Style>

    <!-- Panel frame: grey when inactive, bright cyan when focused, yellow while it is a drop target -->
    <Style Selector="Border#PanelFrame">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InactivePanelBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border#PanelFrame.active">
        <Setter Property="BorderBrush" Value="{StaticResource ActivePanelBrush}" />
    </Style>
    <Style Selector="Border#PanelFrame.dropTarget">
        <Setter Property="BorderBrush" Value="{StaticResource DropTargetBrush}" />
    </Style>
    <Style Selector="Border#PanelFrame TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource RetroFontFamily}" />
    </Style>

    <!-- Path header -->
    <Style Selector="Border#PathHeader">
        <Setter Property="Background" Value="{StaticResource InactivePanelBrush}" />
    </Style>
    <Style Selector="Border#PathHeader TextBlock">
        <Setter Property="Foreground" Value="{StaticResource InactivePanelForegroundBrush}" />
    </Style>
    <Style Selector="Border#PanelFrame.active Border#PathHeader">
        <Setter Property="Background" Value="{StaticResource ActivePanelBrush}" />
    </Style>
    <Style Selector="Border#PanelFrame.active Border#PathHeader TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ActivePanelForegroundBrush}" />
    </Style>

    <!-- Folder tabs -->
    <Style Selector="Border#TabBar">
        <Setter Property="BorderBrush" Value="{StaticResource InactivePanelBrush}" />
    </Style>
    <Style Selector="Border#PanelFrame.active Border#TabBar">
        <Setter Property="BorderBrush" Value="{StaticResource ActivePanelBrush}" />
    </Style>
    <Style Selector="Border.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.tab:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    </Style>
    <Style Selector="Border.tab.selected">
        <Setter Property="Background" Value="{StaticResource InactivePanelBrush}" />
    </Style>
    <Style Selector="Border.tab.selected TextBlock.tabHeader">
        <Setter Property="Foreground" Value="{StaticResource InactivePanelForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border#PanelFrame.active Border.tab.selected">
        <Setter Property="Background" Value="{StaticResource ActivePanelBrush}" />
    </Style>
    <Style Selector="Border#PanelFrame.active Border.tab.selected TextBlock.tabHeader">
        <Setter Property="Foreground" Value="{StaticResource ActivePanelForegroundBrush}" />
    </Style>
    <Style Selector="Button.closeTab">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PanelForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tab:pointerover Button.closeTab, Border.tab.selected Button.closeTab">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.tab.selected Button.closeTab">
        <Setter Property="Foreground" Value="{StaticResource ActivePanelForegroundBrush}" />
    </Style>

    <!-- Column headers and cells -->
    <Style Selector="Border#PanelFrame TextBlock.columnHeader">
        <Setter Property="Foreground" Value="{StaticResource ColumnHeaderBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.cell">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- File rows: compact; cyan cursor bar in the active panel, faint bar in the inactive one -->
    <Style Selector="ListBox#FileList ListBoxItem">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox#FileList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    </Style>
    <Style Selector="Border#PanelFrame ListBox#FileList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, Border#PanelFrame ListBox#FileList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource InactiveCursorBrush}" />
    </Style>
    <Style Selector="Border#PanelFrame.active ListBox#FileList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, Border#PanelFrame.active ListBox#FileList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CursorBrush}" />
    </Style>
    <Style Selector="Border#PanelFrame.active ListBox#FileList ListBoxItem:selected TextBlock.cell">
        <Setter Property="Foreground" Value="{StaticResource CursorForegroundBrush}" />
    </Style>

    <!-- Archives: ZIP, 7z, RAR, TAR (Enter opens them like folders) -->
    <Style Selector="Border#PanelFrame Grid.archive TextBlock.cell">
        <Setter Property="Foreground" Value="{StaticResource ArchiveBrush}" />
    </Style>

    <!-- Marked (Insert/Space/right-drag) items: yellow, also under the cursor -->
    <Style Selector="Border#PanelFrame Grid.marked TextBlock.cell, Border#PanelFrame.active ListBox#FileList ListBoxItem:selected Grid.marked TextBlock.cell">
        <Setter Property="Foreground" Value="{StaticResource MarkedItemBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Panel status bar -->
    <Style Selector="Border#StatusBar">
        <Setter Property="BorderBrush" Value="{StaticResource InactivePanelBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border#PanelFrame.active Border#StatusBar">
        <Setter Property="BorderBrush" Value="{StaticResource ActivePanelBrush}" />
    </Style>
    <Style Selector="Button.statusButton">
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border#PanelFrame Button.statusButton TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
    </Style>

    <!-- Key hint bar -->
    <Style Selector="Border#KeyBar TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource RetroFontFamily}" />
    </Style>
    <Style Selector="Border#KeyBar Button.fkey">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1,4,1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border#KeyBar Button.fkey /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border#KeyBar Button.fkey:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#333333" />
    </Style>
    <Style Selector="Border#KeyBar TextBlock.fkeyNumber">
        <Setter Property="Margin" Value="2,0,3,0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border#KeyBar Border.fkeyLabel">
        <Setter Property="Background" Value="{StaticResource CursorBrush}" />
        <Setter Property="Padding" Value="4,1" />
    </Style>
    <Style Selector="Border#KeyBar Border.fkeyLabel TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CursorForegroundBrush}" />
    </Style>
    <Style Selector="Border#KeyBar Button.fkey:pointerover Border.fkeyLabel">
        <Setter Property="Background" Value="{StaticResource ActivePanelBrush}" />
    </Style>
    <Style Selector="Border#KeyBar Button.fkey:disabled Border.fkeyLabel">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Command line -->
    <Style Selector="Border#CommandLineBar">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="Padding" Value="6,1" />
    </Style>
    <Style Selector="Border#CommandLineBar TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource RetroFontFamily}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.commandLine">
        <Setter Property="Foreground" Value="{StaticResource PanelForegroundBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource PanelForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource RetroFontFamily}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.commandLine /template/ Border#PART_BorderElement, TextBox.commandLine:pointerover /template/ Border#PART_BorderElement, TextBox.commandLine:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.commandLine:focus, TextBox.commandLine:pointerover">
        <Setter Property="Foreground" Value="{StaticResource PanelForegroundBrush}" />
    </Style>

    <!-- Lister (F3 viewer) -->
    <Style Selector="Border#ListerFrame">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ActivePanelBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border#ListerFrame TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RetroFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource PanelForegroundBrush}" />
    </Style>
    <Style Selector="Border#ListerFrame TextBlock#ListerText.hex">
        <Setter Property="Foreground" Value="{StaticResource ActivePanelBrush}" />
    </Style>
    <Style Selector="Border#ListerHeader, Border#ListerStatus">
        <Setter Property="Background" Value="{StaticResource ActivePanelBrush}" />
    </Style>
    <Style Selector="Border#ListerHeader TextBlock, Border#ListerStatus TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ActivePanelForegroundBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Multi-rename tool -->
    <Style Selector="Border#RenameFrame TextBlock.label">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource ColumnHeaderBrush}" />
    </Style>
    <Style Selector="Border#RenameFrame TextBlock.hint">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="FontFamily" Value="{StaticResource RetroFontFamily}" />
    </Style>
    <Style Selector="Border#RenameFrame TextBox">
        <Setter Property="FontFamily" Value="{StaticResource RetroFontFamily}" />
    </Style>
    <Style Selector="Button.token">
        <Setter Property="FontFamily" Value="{StaticResource RetroFontFamily}" />
        <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="Border#RenamePreviewFrame">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InactivePanelBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border#RenamePreviewFrame TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RetroFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource PanelForegroundBrush}" />
    </Style>
    <Style Selector="Border#RenamePreviewFrame TextBlock.columnHeader">
        <Setter Property="Foreground" Value="{StaticResource ColumnHeaderBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox#RenamePreview ListBoxItem">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Border#RenamePreviewFrame TextBlock.newName">
        <Setter Property="Foreground" Value="{StaticResource ActivePanelBrush}" />
    </Style>
    <Style Selector="Border#RenamePreviewFrame Grid.error TextBlock.newName, Border#RenamePreviewFrame Grid.error TextBlock.status">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>
    <Style Selector="Border#RenamePreviewFrame Grid.done TextBlock.status">
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
    </Style>

    <!-- Directory synchronization -->
    <Style Selector="Border#SyncFrame TextBlock.label">
        <Setter Property="Foreground" Value="{StaticResource ColumnHeaderBrush}" />
    </Style>
    <Style Selector="Border#SyncFrame TextBox">
        <Setter Property="FontFamily" Value="{StaticResource RetroFontFamily}" />
    </Style>
    <Style Selector="Border#SyncFrame TextBlock.summary">
        <Setter Property="FontFamily" Value="{StaticResource RetroFontFamily}" />
    </Style>
    <Style Selector="Border#SyncGridFrame">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ActivePanelBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border#SyncGridFrame TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RetroFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource PanelForegroundBrush}" />
    </Style>
    <Style Selector="Border#SyncGridFrame TextBlock.columnHeader">
        <Setter Property="Foreground" Value="{StaticResource ColumnHeaderBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox#SyncGrid ListBoxItem">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Border#SyncGridFrame Grid.copy TextBlock.arrow">
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
    </Style>
    <Style Selector="Border#SyncGridFrame Grid.conflict TextBlock.cell">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>
    <Style Selector="Border#SyncGridFrame Grid.equal TextBlock.cell">
        <Setter Property="Foreground" Value="{StaticResource InactivePanelBrush}" />
    </Style>

    <!-- Dialogs -->
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter, Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
</Styles>
