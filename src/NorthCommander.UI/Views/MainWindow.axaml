<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:NorthCommander.UI.ViewModels"
        xmlns:views="using:NorthCommander.UI.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="NorthCommander.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Title="NorthCommander"
        Width="1200" Height="720"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding OpenSyncDirectoriesCommand}" />
        <KeyBinding Gesture="Ctrl+M" Command="{Binding MultiRenameFilesCommand}" />
        <KeyBinding Gesture="F3" Command="{Binding ViewCommand}" />
        <KeyBinding Gesture="F4" Command="{Binding EditCommand}" />
        <KeyBinding Gesture="F7" Command="{Binding MakeDirectoryCommand}" />
        <KeyBinding Gesture="F10" Command="{Binding QuitCommand}" />
        <KeyBinding Gesture="Alt+X" Command="{Binding QuitCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="F6" Command="{Binding MoveCommand}" />
        <KeyBinding Gesture="Shift+F6" Command="{Binding RenameCommand}" />
        <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
        <KeyBinding Gesture="F8" Command="{Binding DeleteCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding NewTabCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
    </Window.KeyBindings>

    <Panel>
        <DockPanel IsEnabled="{Binding !IsModalOpen}">
            <!-- Norton Commander F-key bar (clickable) -->
            <Border x:Name="KeyBar" DockPanel.Dock="Bottom">
                <UniformGrid Rows="1" Columns="7">
                    <Button Classes="fkey" Command="{Binding ViewCommand}" ToolTip.Tip="F3 Lister">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="fkeyNumber" Text="F3" />
                            <Border Grid.Column="1" Classes="fkeyLabel"><TextBlock Text="Lister" /></Border>
                        </Grid>
                    </Button>
                    <Button Classes="fkey" Command="{Binding EditCommand}" ToolTip.Tip="F4 Edit">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="fkeyNumber" Text="F4" />
                            <Border Grid.Column="1" Classes="fkeyLabel"><TextBlock Text="Edit" /></Border>
                        </Grid>
                    </Button>
                    <Button Classes="fkey" Command="{Binding CopyCommand}" ToolTip.Tip="F5 Copy">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="fkeyNumber" Text="F5" />
                            <Border Grid.Column="1" Classes="fkeyLabel"><TextBlock Text="Copy" /></Border>
                        </Grid>
                    </Button>
                    <Button Classes="fkey" Command="{Binding MoveCommand}" ToolTip.Tip="F6 Move">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="fkeyNumber" Text="F6" />
                            <Border Grid.Column="1" Classes="fkeyLabel"><TextBlock Text="Move" /></Border>
                        </Grid>
                    </Button>
                    <Button Classes="fkey" Command="{Binding MakeDirectoryCommand}" ToolTip.Tip="F7 MkDir">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="fkeyNumber" Text="F7" />
                            <Border Grid.Column="1" Classes="fkeyLabel"><TextBlock Text="MkDir" /></Border>
                        </Grid>
                    </Button>
                    <Button Classes="fkey" Command="{Binding DeleteCommand}" ToolTip.Tip="F8 Delete">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="fkeyNumber" Text="F8" />
                            <Border Grid.Column="1" Classes="fkeyLabel"><TextBlock Text="Delete" /></Border>
                        </Grid>
                    </Button>
                    <Button Classes="fkey" Command="{Binding QuitCommand}" ToolTip.Tip="F10 Quit">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="fkeyNumber" Text="F10" />
                            <Border Grid.Column="1" Classes="fkeyLabel"><TextBlock Text="Quit" /></Border>
                        </Grid>
                    </Button>
                </UniformGrid>
            </Border>

            <!-- Command line: runs in the active panel's folder -->
            <Border x:Name="CommandLineBar" DockPanel.Dock="Bottom">
                <DockPanel>
                    <TextBlock x:Name="CommandPrompt"
                               DockPanel.Dock="Left"
                               MaxWidth="480"
                               TextTrimming="PrefixCharacterEllipsis"
                               Text="{Binding ActivePanel.SelectedTab.CurrentPath, StringFormat='{}{0}&gt;'}" />
                    <TextBlock DockPanel.Dock="Right" Text="running…" IsVisible="{Binding ExecuteCommandLineCommand.IsRunning}" />
                    <TextBox x:Name="CommandBox" Classes="commandLine" Text="{Binding CommandText}" />
                </DockPanel>
            </Border>

            <Grid ColumnDefinitions="*,6,*" Margin="4">
                <views:FilePanelView x:Name="LeftPanelView"
                                     Grid.Column="0"
                                     DataContext="{Binding LeftPanel}" />
                <GridSplitter Grid.Column="1"
                              Background="Transparent"
                              ResizeDirection="Columns" />
                <views:FilePanelView x:Name="RightPanelView"
                                     Grid.Column="2"
                                     DataContext="{Binding RightPanel}" />
            </Grid>
        </DockPanel>

        <views:ListerView x:Name="ListerView"
                          DataContext="{Binding Lister}"
                          IsVisible="{Binding IsOpen}"
                          IsEnabled="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).ConflictDialog.IsOpen}" />

        <Panel IsEnabled="{Binding !ConflictDialog.IsOpen}">
            <views:TransferDialogView x:Name="TransferDialogView"
                                      DataContext="{Binding TransferDialog}"
                                      IsVisible="{Binding IsOpen}" />
            <views:SyncDirectoriesView x:Name="SyncDirectoriesView"
                                       DataContext="{Binding SyncDirectories}"
                                       IsVisible="{Binding IsOpen}" />
            <views:MultiRenameView x:Name="MultiRenameView"
                                   DataContext="{Binding MultiRename}"
                                   IsVisible="{Binding IsOpen}" />
            <views:PromptDialogView x:Name="PromptDialogView"
                                    DataContext="{Binding PromptDialog}"
                                    IsVisible="{Binding IsOpen}" />
        </Panel>

        <views:ConflictDialogView x:Name="ConflictDialogView"
                                  DataContext="{Binding ConflictDialog}"
                                  IsVisible="{Binding IsOpen}" />
    </Panel>
</Window>
