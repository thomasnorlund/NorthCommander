<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NorthCommander.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NorthCommander.UI.Views.ConflictDialogView"
             x:DataType="vm:ConflictDialogViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="Button.choice">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource OverlayBackdropBrush}">
        <Border Width="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogBackgroundBrush}"
                BorderBrush="{StaticResource ErrorBrush}"
                BorderThickness="1"
                CornerRadius="6"
                BoxShadow="0 8 32 0 #60000000">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource ErrorBrush}"
                        CornerRadius="5,5,0,0"
                        Padding="14,8">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               Foreground="White" />
                </Border>

                <StackPanel Margin="16" Spacing="10">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TargetFolder, StringFormat='in {0}'}" Opacity="0.8" TextTrimming="PrefixCharacterEllipsis" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,4,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Existing file:" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ExistingDetails}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="New file:" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NewDetails}" />
                    </Grid>

                    <TextBlock Text="{Binding RenameHint}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

                    <WrapPanel HorizontalAlignment="Right" Margin="0,6,0,0" ItemSpacing="8" LineSpacing="8">
                        <Button x:Name="OverwriteButton" Classes="choice accent" Content="Overwrite" Command="{Binding OverwriteCommand}" />
                        <Button Classes="choice" Content="Overwrite All" Command="{Binding OverwriteAllCommand}" />
                        <Button Classes="choice" Content="Skip" Command="{Binding SkipCommand}" />
                        <Button Classes="choice" Content="Skip All" Command="{Binding SkipAllCommand}" />
                        <Button Classes="choice" Content="Rename" Command="{Binding RenameCommand}" />
                        <Button Classes="choice" Content="Cancel" Command="{Binding CancelCommand}" />
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Border>
</UserControl>
