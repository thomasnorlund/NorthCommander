<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CommanderTom.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
             x:Class="CommanderTom.UI.Views.FilePanelView"
             x:DataType="vm:FilePanelViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding SelectedTab.OpenSelectedCommand}" />
        <KeyBinding Gesture="Back" Command="{Binding SelectedTab.GoUpCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding SelectedTab.RefreshCommand}" />
    </UserControl.KeyBindings>


    <Border x:Name="PanelFrame"
            Classes.active="{Binding IsActive}"
            CornerRadius="2">
        <DockPanel>
            <!-- Current path -->
            <Border x:Name="PathHeader" DockPanel.Dock="Top" Padding="8,5">
                <TextBlock Text="{Binding SelectedTab.CurrentPath}"
                           FontWeight="SemiBold"
                           TextTrimming="PrefixCharacterEllipsis" />
            </Border>

            <ProgressBar DockPanel.Dock="Top"
                         IsIndeterminate="True"
                         IsVisible="{Binding SelectedTab.IsLoading}"
                         MinHeight="2" Height="2" />

            <!-- Column headers -->
            <Border x:Name="TabBar" DockPanel.Dock="Top" Padding="4,3,4,0" BorderThickness="0,0,0,2">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TabViewModel">
                                <Border Classes="tab"
                                        Classes.selected="{Binding IsSelected}"
                                        CornerRadius="4,4,0,0"
                                        Padding="10,3,4,3"
                                        ToolTip.Tip="{Binding CurrentPath}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Lock Tab" Command="{Binding LockCommand}" IsVisible="{Binding !IsLocked}" />
                                            <MenuItem Header="Unlock Tab" Command="{Binding UnlockCommand}" IsVisible="{Binding IsLocked}" />
                                            <Separator />
                                            <MenuItem Header="Close Tab" InputGesture="Ctrl+W" Command="{Binding CloseCommand}" IsEnabled="{Binding CanClose}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Classes="tabHeader"
                                                   Text="{Binding Header}"
                                                   FontSize="12"
                                                   MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Panel Width="16" Height="16" IsVisible="{Binding CanClose}">
                                            <Button Classes="closeTab" Content="✕" Command="{Binding CloseCommand}" ToolTip.Tip="Close tab (Ctrl+W)" />
                                        </Panel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="*,70,110,140"
                  Margin="12,4,12,2">
                <TextBlock Grid.Column="0" Classes="columnHeader" Text="Name" />
                <TextBlock Grid.Column="1" Classes="columnHeader" Text="Ext" />
                <TextBlock Grid.Column="2" Classes="columnHeader" Text="Size" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Classes="columnHeader" Text="Date" Margin="12,0,0,0" />
            </Grid>

            <!-- Status bar: listing summary, or transfer progress while this panel is focused -->
            <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="8,3">
                <Panel>
                    <Panel IsVisible="{Binding !ShowTransferStatus}">
                        <TextBlock Text="{Binding SelectedTab.StatusText}" FontSize="12" />
                        <TextBlock Text="{Binding SelectedTab.ErrorMessage}"
                                   IsVisible="{Binding SelectedTab.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="12" />
                    </Panel>

                    <Grid IsVisible="{Binding ShowTransferStatus}"
                          ColumnDefinitions="140,*,Auto,Auto"
                          ColumnSpacing="8">
                        <ProgressBar Grid.Column="0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Transfers.ProgressPercentage}"
                                     Foreground="{StaticResource ActivePanelBrush}"
                                     MinWidth="0" MinHeight="6" Height="6"
                                     VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Transfers.StatusText}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Classes="statusButton"
                                Command="{Binding Transfers.TogglePauseCommand}">
                            <Panel>
                                <TextBlock Text="Pause" IsVisible="{Binding !Transfers.IsPaused}" />
                                <TextBlock Text="Resume" IsVisible="{Binding Transfers.IsPaused}" />
                            </Panel>
                        </Button>
                        <Button Grid.Column="3"
                                Classes="statusButton"
                                Content="Cancel"
                                Command="{Binding Transfers.CancelAllCommand}" />
                    </Grid>
                </Panel>
            </Border>

            <!-- File list (virtualized) -->
            <ListBox x:Name="FileList"
                     ItemsSource="{Binding SelectedTab.Items}"
                     SelectedItem="{Binding SelectedTab.SelectedItem}"
                     SelectionMode="Single"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileItemViewModel">
                        <Grid ColumnDefinitions="*,70,110,140"
                              Opacity="{Binding Opacity}"
                              Classes.marked="{Binding IsMarked}">
                            <TextBlock Grid.Column="0" Classes="cell" Text="{Binding DisplayName}" />
                            <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Extension}" />
                            <TextBlock Grid.Column="2" Classes="cell" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Classes="cell" Text="{Binding DateText}" Margin="12,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
