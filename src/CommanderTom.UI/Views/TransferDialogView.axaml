<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CommanderTom.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CommanderTom.UI.Views.TransferDialogView"
             x:DataType="vm:TransferDialogViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </UserControl.KeyBindings>

    <!-- Backdrop swallows clicks so the panels behind stay untouched -->
    <Border Background="{StaticResource OverlayBackdropBrush}">
        <Border Width="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogBackgroundBrush}"
                BorderBrush="{StaticResource ActivePanelBrush}"
                BorderThickness="1"
                CornerRadius="6"
                BoxShadow="0 8 32 0 #60000000">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource ActivePanelBrush}"
                        CornerRadius="5,5,0,0"
                        Padding="14,8">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ActivePanelForegroundBrush}" />
                </Border>

                <StackPanel Margin="16" Spacing="10">
                    <TextBlock Text="{Binding Prompt}" TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="TargetBox" Text="{Binding TargetPath}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                        <Button Content="{Binding ConfirmText}"
                                Command="{Binding ConfirmCommand}"
                                Classes="accent"
                                MinWidth="90"
                                HorizontalContentAlignment="Center" />
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                MinWidth="90"
                                HorizontalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Border>
</UserControl>
